          {
            "group": "Start Here",
            "pages": ["quickstart", "download-installation"]
          },
          {
            "group": "What You Can Do",
            "pages": [
              "features/dashboard",
              "features/products",
              "features/inventory",
              "features/suppliers",
              "features/sales-pos",
              "features/employees",
              "features/reports"
            ]
          },
          {
            "group": "Your Account",
            "pages": ["accounts/user-registration", "accounts/roles-permissions"]
          },
          {
            "group": "Settings",
            "pages": ["settings/payment-settings", "settings/taxes-discounts", "settings/customization"]
          },
          {
            "group": "Backup & Safety",
            "pages": ["backup-data", "restore-data"]
          },
          {
            "group": "Tips & Tricks",
            "pages": ["quick-tips"]
          },
          {
            "group": "Extra Info",
            "pages": ["useful-links", "change-log"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
